{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Augmentation",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/augment_dataset.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"}
        },
        {
            "name": "Train Model",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"}
        },
        {
            "name": "Run Flask UI",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"FLASK_ENV": "development"},
            "args": []
        }
    ]
}
